<div class="dashboard-header">
  <h2><i class="bi bi-person-badge"></i> Welcome, {{user.username}} (Manager)</h2>
  <div class="quick-links">
    <a href="/manager/statistics" class="btn btn-info"><i class="bi bi-bar-chart"></i> Statistics</a>
    <a href="/manager/users" class="btn btn-primary"><i class="bi bi-people"></i> Manage Users</a>
  </div>
</div>

<div class="stats-cards">
  <div class="stat-card">
    <div class="stat-icon bg-primary"><i class="bi bi-box-seam"></i></div>
    <div class="stat-info">
      <h3>{{deliveries.length}}</h3>
      <p>Total Deliveries</p>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-warning"><i class="bi bi-clock"></i></div>
    <div class="stat-info">
      <h3>{{#with (filterByStatus deliveries "Pending")}}{{this.length}}{{/with}}</h3>
      <p>Pending</p>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-success"><i class="bi bi-check-circle"></i></div>
    <div class="stat-info">
      <h3>{{#with (filterByStatus deliveries "Delivered")}}{{this.length}}{{/with}}</h3>
      <p>Delivered</p>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-info"><i class="bi bi-people"></i></div>
    <div class="stat-info">
      <h3>{{personnel.length}}</h3>
      <p>Personnel</p>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <h4><i class="bi bi-plus-circle"></i> Create New Delivery</h4>
  </div>
  <div class="card-body">
    <form action="/manager/assign" method="POST" class="delivery-form">
      <div class="row">
        <div class="col-md-6 mb-3">
          <label><i class="bi bi-card-text"></i> Description</label>
          <input type="text" name="description" class="form-control" required placeholder="Package description">
        </div>
        <div class="col-md-6 mb-3">
          <label><i class="bi bi-person"></i> Customer Name</label>
          <input type="text" name="customerName" class="form-control" placeholder="Customer name">
        </div>
      </div>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label><i class="bi bi-telephone"></i> Customer Phone</label>
          <input type="text" name="customerPhone" class="form-control" placeholder="Phone number">
        </div>
        <div class="col-md-6 mb-3">
          <label><i class="bi bi-geo-alt"></i> Delivery Address</label>
          <input type="text" name="address" class="form-control" placeholder="Delivery address">
        </div>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-exclamation-triangle"></i> Priority</label>
          <select name="priority" class="form-control">
            <option value="Low">Low</option>
            <option value="Medium" selected>Medium</option>
            <option value="High">High</option>
            <option value="Urgent">Urgent</option>
          </select>
        </div>
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-person-plus"></i> Assign to Personnel</label>
          <select name="assignedTo" class="form-control" required>
            {{#each personnel}}
            <option value="{{this.username}}">{{this.username}}</option>
            {{/each}}
          </select>
        </div>
        <div class="col-md-4 mb-3">
          <label>&nbsp;</label>
          <button type="submit" class="btn btn-success w-100"><i class="bi bi-plus-circle"></i> Create Delivery</button>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h4><i class="bi bi-list-ul"></i> All Deliveries</h4>
  </div>
  <div class="card-body">
    <form action="/manager/search" method="GET" class="search-form mb-3">
      <div class="row">
        <div class="col-md-4">
          <input type="text" name="query" class="form-control" placeholder="Search deliveries..." value="{{filters.query}}">
        </div>
        <div class="col-md-3">
          <select name="status" class="form-control">
            <option value="all">All Status</option>
            <option value="Pending" {{#if (eq filters.status "Pending")}}selected{{/if}}>Pending</option>
            <option value="In Progress" {{#if (eq filters.status "In Progress")}}selected{{/if}}>In Progress</option>
            <option value="Delivered" {{#if (eq filters.status "Delivered")}}selected{{/if}}>Delivered</option>
          </select>
        </div>
        <div class="col-md-3">
          <select name="priority" class="form-control">
            <option value="all">All Priority</option>
            <option value="Low" {{#if (eq filters.priority "Low")}}selected{{/if}}>Low</option>
            <option value="Medium" {{#if (eq filters.priority "Medium")}}selected{{/if}}>Medium</option>
            <option value="High" {{#if (eq filters.priority "High")}}selected{{/if}}>High</option>
            <option value="Urgent" {{#if (eq filters.priority "Urgent")}}selected{{/if}}>Urgent</option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Search</button>
        </div>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th><i class="bi bi-hash"></i> ID</th>
            <th><i class="bi bi-card-text"></i> Description</th>
            <th><i class="bi bi-person"></i> Customer</th>
            <th><i class="bi bi-telephone"></i> Phone</th>
            <th><i class="bi bi-geo-alt"></i> Address</th>
            <th><i class="bi bi-exclamation-triangle"></i> Priority</th>
            <th><i class="bi bi-person-check"></i> Assigned To</th>
            <th><i class="bi bi-flag"></i> Status</th>
            <th><i class="bi bi-gear"></i> Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each deliveries}}
          <tr>
            <td>{{id}}</td>
            <td>{{description}}</td>
            <td>{{customerName}}</td>
            <td>{{customerPhone}}</td>
            <td>{{address}}</td>
            <td><span class="badge priority-{{priority}}">{{priority}}</span></td>
            <td>{{assignedTo}}</td>
            <td><span class="badge status-{{status}}">{{status}}</span></td>
            <td>
              <div class="btn-group">
                <a href="/manager/edit-delivery/{{id}}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Edit</a>
                <form action="/manager/delete-delivery/{{id}}" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this delivery?');">
                  <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Delete</button>
                </form>
              </div>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="9" class="text-center">No deliveries found</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
