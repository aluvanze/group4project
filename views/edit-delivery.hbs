<div class="card">
  <div class="card-header">
    <h4><i class="bi bi-pencil"></i> Edit Delivery #{{delivery.id}}</h4>
  </div>
  <div class="card-body">
    <form action="/manager/edit-delivery/{{delivery.id}}" method="POST">
      <div class="row">
        <div class="col-md-6 mb-3">
          <label><i class="bi bi-card-text"></i> Description</label>
          <input type="text" name="description" class="form-control" required value="{{delivery.description}}">
        </div>
        <div class="col-md-6 mb-3">
          <label><i class="bi bi-person"></i> Customer Name</label>
          <input type="text" name="customerName" class="form-control" value="{{delivery.customerName}}">
        </div>
      </div>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label><i class="bi bi-telephone"></i> Customer Phone</label>
          <input type="text" name="customerPhone" class="form-control" value="{{delivery.customerPhone}}">
        </div>
        <div class="col-md-6 mb-3">
          <label><i class="bi bi-geo-alt"></i> Delivery Address</label>
          <input type="text" name="address" class="form-control" value="{{delivery.address}}">
        </div>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-exclamation-triangle"></i> Priority</label>
          <select name="priority" class="form-control">
            <option value="Low" {{#if (eq delivery.priority "Low")}}selected{{/if}}>Low</option>
            <option value="Medium" {{#if (eq delivery.priority "Medium")}}selected{{/if}}>Medium</option>
            <option value="High" {{#if (eq delivery.priority "High")}}selected{{/if}}>High</option>
            <option value="Urgent" {{#if (eq delivery.priority "Urgent")}}selected{{/if}}>Urgent</option>
          </select>
        </div>
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-person-plus"></i> Assign to Personnel</label>
          <select name="assignedTo" class="form-control" required>
            {{#each personnel}}
            <option value="{{this.username}}" {{#if (eq this.username ../delivery.assignedTo)}}selected{{/if}}>{{this.username}}</option>
            {{/each}}
          </select>
        </div>
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-flag"></i> Status</label>
          <select name="status" class="form-control">
            <option value="Pending" {{#if (eq delivery.status "Pending")}}selected{{/if}}>Pending</option>
            <option value="In Progress" {{#if (eq delivery.status "In Progress")}}selected{{/if}}>In Progress</option>
            <option value="Delivered" {{#if (eq delivery.status "Delivered")}}selected{{/if}}>Delivered</option>
          </select>
        </div>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Update Delivery</button>
        <a href="/manager/dashboard" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancel</a>
      </div>
    </form>
  </div>
</div>

