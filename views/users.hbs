<div class="dashboard-header">
  <h2><i class="bi bi-people"></i> User Management</h2>
  <div class="quick-links">
    <a href="/manager/dashboard" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
    <a href="/manager/statistics" class="btn btn-info"><i class="bi bi-bar-chart"></i> Statistics</a>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <h4><i class="bi bi-person-plus"></i> Add New User</h4>
  </div>
  <div class="card-body">
    <form action="/manager/add-user" method="POST">
      <div class="row">
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-person"></i> Username</label>
          <input type="text" name="username" class="form-control" required placeholder="Enter username">
        </div>
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-lock"></i> Password</label>
          <input type="password" name="password" class="form-control" required placeholder="Enter password">
        </div>
        <div class="col-md-2 mb-3">
          <label><i class="bi bi-shield"></i> Role</label>
          <select name="role" class="form-control" required>
            <option value="manager">Manager</option>
            <option value="personnel">Personnel</option>
          </select>
        </div>
        <div class="col-md-2 mb-3">
          <label>&nbsp;</label>
          <button type="submit" class="btn btn-success w-100"><i class="bi bi-plus-circle"></i> Add User</button>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h4><i class="bi bi-list-ul"></i> All Users</h4>
  </div>
  <div class="card-body">
    <div class="row mb-3">
      <div class="col-md-6">
        <div class="stats-mini">
          <span class="badge bg-primary">Total: {{users.length}}</span>
          <span class="badge bg-info">Managers: {{#with (filterByRole users "manager")}}{{this.length}}{{/with}}</span>
          <span class="badge bg-success">Personnel: {{#with (filterByRole users "personnel")}}{{this.length}}{{/with}}</span>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th><i class="bi bi-person"></i> Username</th>
            <th><i class="bi bi-lock"></i> Password</th>
            <th><i class="bi bi-shield"></i> Role</th>
            <th><i class="bi bi-gear"></i> Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each users}}
          <tr>
            <td>{{username}}</td>
            <td>••••••••</td>
            <td><span class="badge role-{{role}}">{{role}}</span></td>
            <td>
              <div class="btn-group">
                <a href="/manager/edit-user/{{username}}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Edit</a>
                <form action="/manager/delete-user/{{username}}" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                  <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Delete</button>
                </form>
              </div>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="4" class="text-center">No users found</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

