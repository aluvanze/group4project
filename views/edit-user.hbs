<div class="card">
  <div class="card-header">
    <h4><i class="bi bi-pencil"></i> Edit User: {{editUser.username}}</h4>
  </div>
  <div class="card-body">
    <form action="/manager/edit-user/{{editUser.username}}" method="POST">
      <div class="row">
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-person"></i> Username</label>
          <input type="text" name="newUsername" class="form-control" required value="{{editUser.username}}">
        </div>
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-lock"></i> Password</label>
          <input type="password" name="password" class="form-control" required value="{{editUser.password}}">
        </div>
        <div class="col-md-4 mb-3">
          <label><i class="bi bi-shield"></i> Role</label>
          <select name="role" class="form-control" required>
            <option value="manager" {{#if (eq editUser.role "manager")}}selected{{/if}}>Manager</option>
            <option value="personnel" {{#if (eq editUser.role "personnel")}}selected{{/if}}>Personnel</option>
          </select>
        </div>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Update User</button>
        <a href="/manager/users" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancel</a>
      </div>
    </form>
  </div>
</div>

